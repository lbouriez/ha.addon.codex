#!/usr/local/bin/python3 -I
"""Fixed-destination HA access; the Supervisor credential never enters shell config."""
import asyncio
import json
from pathlib import Path
import sys
from urllib.parse import unquote, urlsplit

CORE_URL = "http://supervisor/core/api"
SUPERVISOR_URL = "http://supervisor"
TOKEN_FILE = Path("/tmp/codex/ha-token")
OPTIONS_FILE = Path("/data/options.json")


def headers(token):
    return {"Authorization": f"Bearer {token}"}


def http_status(error):
    import httpx
    if isinstance(error, httpx.HTTPStatusError):
        return error.response.status_code
    for child in getattr(error, "exceptions", ()):
        if status := http_status(child):
            return status
    return None


async def probe_official(token, url=CORE_URL + "/mcp"):
    import anyio
    import httpx
    # HA's official endpoint is stateless and returns one JSON result per POST.
    # Inspect HTTP status before the SDK can turn it into a generic closed-session error.
    try:
        with anyio.fail_after(5):
            async with httpx.AsyncClient(headers=headers(token), timeout=5, follow_redirects=False, trust_env=False) as client:
                response = await client.post(url, headers={"Accept": "application/json, text/event-stream"}, json={
                    "jsonrpc": "2.0", "id": "codex-addon-probe", "method": "initialize",
                    "params": {"protocolVersion": "2025-03-26", "capabilities": {},
                               "clientInfo": {"name": "codex-ha-addon", "version": "0.4.0"}},
                })
                response.raise_for_status()
                message = response.json()
                result = message.get("result", {})
                if (message.get("id") != "codex-addon-probe" or not result.get("protocolVersion")
                        or not isinstance(result.get("capabilities"), dict) or not result.get("serverInfo")):
                    return "unreachable"
        return "available"
    except Exception as error:
        status = http_status(error)
        if status == 404:
            return "absent"
        if status in (401, 403):
            return "access_denied"
        return "unreachable"


async def bridge_official(token, url=CORE_URL + "/mcp"):
    import anyio
    import httpx
    from mcp.client.streamable_http import streamable_http_client
    from mcp.server.stdio import stdio_server

    async def relay(source, destination, tasks):
        async for message in source:
            if isinstance(message, Exception):
                raise message
            await destination.send(message)
        tasks.cancel_scope.cancel()

    async with httpx.AsyncClient(
        headers=headers(token), timeout=httpx.Timeout(30, read=300),
        follow_redirects=False, trust_env=False,
    ) as client:
        async with streamable_http_client(url, http_client=client) as (remote_read, remote_write, _):
            async with stdio_server() as (local_read, local_write):
                async with anyio.create_task_group() as tasks:
                    tasks.start_soon(relay, local_read, remote_write, tasks)
                    tasks.start_soon(relay, remote_read, local_write, tasks)


def api_url(target, path):
    if target not in ("core", "supervisor"):
        raise ValueError("API target must be core or supervisor")
    parts = urlsplit(path)
    if not path.startswith("/") or path.startswith("//") or parts.scheme or parts.netloc or parts.fragment:
        raise ValueError("Use an API-relative path, not a URL")
    decoded = parts.path
    for _ in range(5):
        previous, decoded = decoded, unquote(decoded)
        if previous == decoded:
            break
    if "\\" in decoded or "%" in decoded or any(segment in (".", "..") for segment in decoded.split("/")):
        raise ValueError("Invalid API path")
    if any(ord(char) < 32 or ord(char) == 127 for char in path + decoded):
        raise ValueError("Invalid control character in API path")
    if target == "core" and decoded.startswith("/hassio"):
        raise ValueError("Use the Supervisor API target for Supervisor operations")
    return (CORE_URL if target == "core" else SUPERVISOR_URL) + path


def request_api(token, target, method, path, payload=None, timeout=60):
    import httpx
    if method not in ("GET", "POST", "PUT", "PATCH", "DELETE"):
        raise ValueError("Unsupported HTTP method")
    with httpx.Client(headers=headers(token), timeout=timeout, follow_redirects=False, trust_env=False) as client:
        response = client.request(method, api_url(target, path), json=payload)
        response.raise_for_status()
        return response.text


async def websocket_api(token, command, follow=False, url="ws://supervisor/core/websocket"):
    import aiohttp
    if not isinstance(command, dict) or not isinstance(command.get("type"), str):
        raise ValueError("WebSocket input must be a JSON object with a type")
    if command["type"].startswith(("auth", "supervisor/", "hassio/")):
        raise ValueError("Use a normal HA WebSocket command; authentication is automatic")
    async def reject_redirect(*_args):
        raise ValueError("HA WebSocket redirects are not allowed")

    trace = aiohttp.TraceConfig()
    trace.on_request_redirect.append(reject_redirect)
    async with aiohttp.ClientSession(trust_env=False, trace_configs=[trace]) as client:
        async with client.ws_connect(url, heartbeat=30, max_msg_size=16 * 1024 * 1024) as ws:
            async with asyncio.timeout(30):
                greeting = await ws.receive_json()
                if greeting.get("type") != "auth_required":
                    raise ValueError("Unexpected HA WebSocket authentication handshake")
                await ws.send_json({"type": "auth", "access_token": token})
                if (await ws.receive_json()).get("type") != "auth_ok":
                    raise ValueError("HA WebSocket access denied")
                await ws.send_json({**command, "id": 1})
                response = await ws.receive_json()
                if response.get("type") != "result" or response.get("id") != 1:
                    raise ValueError("Unexpected HA WebSocket command response")
                print(json.dumps(response), flush=True)
                if not response.get("success"):
                    return 1
            if follow:
                async for message in ws:
                    if message.type == aiohttp.WSMsgType.TEXT:
                        print(message.data, flush=True)
                    elif message.type == aiohttp.WSMsgType.ERROR:
                        raise ValueError("HA WebSocket connection failed")
            return 0


def read_token():
    token = TOKEN_FILE.read_text(encoding="utf-8").strip()
    if not token:
        raise ValueError("Supervisor token unavailable; run this command inside the HA OS add-on")
    return token


def main(args):
    if not args:
        raise ValueError("Use ha-api status | core METHOD /path | supervisor METHOD /path | ws")
    token = read_token()
    if args[0] in ("status", "mcp"):
        if len(args) != 1:
            raise ValueError("Unexpected arguments")
        options = json.loads(OPTIONS_FILE.read_text(encoding="utf-8"))
        enabled = options.get("enable_mcp", True)
        detected = asyncio.run(probe_official(token)) if enabled else "not_probed"
        if args[0] == "status":
            result = {"mcp_enabled": enabled, "official_mcp": detected}
            for target, path in (("core", "/"), ("supervisor", "/core/info")):
                try:
                    request_api(token, target, "GET", path, timeout=5)
                    result[target + "_api"] = "available"
                except Exception:
                    result[target + "_api"] = "unavailable"
            print(json.dumps(result, indent=2))
            return 0
        if not enabled:
            raise ValueError("Home Assistant MCP is disabled in App options")
        if detected != "available":
            raise ValueError(
                f"Official HA MCP: {detected}. Enable the Model Context Protocol Server "
                "integration and check its access settings and HA Core/Supervisor versions."
            )
        print("[INFO] Connected to the official Home Assistant MCP server", file=sys.stderr)
        asyncio.run(bridge_official(token))
        return 0
    if args in (["ws"], ["ws", "--follow"]):
        return asyncio.run(websocket_api(token, json.load(sys.stdin), follow=len(args) == 2))
    if len(args) != 3:
        raise ValueError("Use ha-api core|supervisor METHOD /path; send optional JSON on stdin")
    target, method, path = args
    method = method.upper()
    payload = None
    if method in ("POST", "PUT", "PATCH") and not sys.stdin.isatty():
        text = sys.stdin.read()
        payload = json.loads(text) if text.strip() else None
    print(request_api(token, target, method, path, payload))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (ValueError, OSError) as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        raise SystemExit(1)
    except Exception as error:
        # Do not dump HTTP headers, exception groups, tokens or full response bodies.
        status = http_status(error)
        print(f"[ERROR] HA request failed ({'HTTP ' + str(status) if status else type(error).__name__})", file=sys.stderr)
        raise SystemExit(1)
