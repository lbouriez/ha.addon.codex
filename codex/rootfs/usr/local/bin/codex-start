#!/usr/bin/env bash
set -euo pipefail

font_size="$(jq -r '.terminal_font_size // 14' /data/options.json)"
case "$font_size" in
  *[!0-9]*|'') font_size=14 ;;
esac
if [[ "$font_size" -lt 10 || "$font_size" -gt 24 ]]; then
  font_size=14
fi

theme="$(jq -r '.terminal_theme // "dark"' /data/options.json)"
terminal_scrollback="$(jq -r '.terminal_scrollback // 10000' /data/options.json)"
case "$terminal_scrollback" in
  *[!0-9]*|'') terminal_scrollback=10000 ;;
esac
if [[ "$terminal_scrollback" -lt 1000 || "$terminal_scrollback" -gt 50000 ]]; then
  terminal_scrollback=10000
fi
preserve_terminal_history="$(jq -r 'if .preserve_terminal_history == null then true else .preserve_terminal_history end' /data/options.json)"
reasoning_effort="$(jq -r '.reasoning_effort // "default"' /data/options.json)"
case "$reasoning_effort" in
  default|low|medium|high|xhigh|max|ultra) ;;
  *) reasoning_effort=default ;;
esac
session_persist="$(jq -r '.session_persistence // false' /data/options.json)"
yolo_mode="$(jq -r '.yolo_mode // false' /data/options.json)"
work_dir="$(jq -r '.working_directory // "/homeassistant"' /data/options.json)"
enable_mcp="$(jq -r 'if .enable_mcp == null then true else .enable_mcp end' /data/options.json)"
default_model="$(jq -r '.default_model // ""' /data/options.json)"
# HA preserves saved options across upgrades, including the old image default.
if [[ "$default_model" == "gpt-5.4" ]]; then
  echo '[INFO] Migrating legacy gpt-5.4 App default to the Codex recommended model. Clear default_model in App options to persist this choice.'
  default_model=""
fi
codex_permissions="$(jq -r '.codex_permissions // "workspace"' /data/options.json)"
codex_approval_policy="$(jq -r '.codex_approval_policy // "on-request"' /data/options.json)"
if [[ "$yolo_mode" == "true" ]]; then
  codex_permissions="full_access"
  codex_approval_policy="never"
  echo '[INFO] YOLO mode enabled: Codex sandbox and approval prompts are disabled.'
fi
auto_update_codex="$(jq -r '.auto_update_codex // false' /data/options.json)"
codex_update_timeout="$(jq -r '.codex_update_timeout // 300' /data/options.json)"
case "$codex_update_timeout" in
  *[!0-9]*|'') codex_update_timeout=300 ;;
esac
if [[ "$codex_update_timeout" -lt 30 || "$codex_update_timeout" -gt 300 ]]; then
  codex_update_timeout=300
fi

export CODEX_STATE_ROOT="/data/codex-home"
export CODEX_MANAGED_ROOT="/data/codex-managed"
export CODEX_WORK_DIR="$work_dir"
export CODEX_SESSION_PERSIST="$session_persist"
export CODEX_YOLO_MODE="$yolo_mode"
export CODEX_TERMINAL_SCROLLBACK="$terminal_scrollback"
export CODEX_PRESERVE_TERMINAL_HISTORY="$preserve_terminal_history"
export CODEX_REASONING_EFFORT="$reasoning_effort"
export CODEX_ENABLE_MCP="$enable_mcp"
export CODEX_DEFAULT_MODEL="$default_model"
export CODEX_PERMISSIONS="$codex_permissions"
export CODEX_APPROVAL_POLICY="$codex_approval_policy"
export CODEX_SUPERVISOR_TOKEN_FILE="/tmp/codex/ha-token"

mkdir -p \
  "$CODEX_STATE_ROOT/users" \
  "$CODEX_MANAGED_ROOT" \
  /tmp/codex

chmod 700 /tmp/codex

if [[ -d /homeassistant/.codex-home && ! -d "$CODEX_STATE_ROOT/legacy-global-home" ]]; then
  cp -a /homeassistant/.codex-home "$CODEX_STATE_ROOT/legacy-global-home"
  echo "[INFO] Backed up legacy Codex state from /homeassistant/.codex-home to $CODEX_STATE_ROOT/legacy-global-home"
fi

grant_group_root_access() {
  local target="$1"
  if [[ ! -e "$target" ]]; then
    return
  fi

  if ! setfacl -R -m g:root:rwx "$target" 2>/dev/null; then
    chmod -R g+rwX "$target" 2>/dev/null || true
  fi

  if [[ -d "$target" ]]; then
    setfacl -R -d -m g:root:rwx "$target" 2>/dev/null || true
  fi
}

grant_group_root_access /homeassistant
grant_group_root_access /share
grant_group_root_access /media
grant_group_root_access "$work_dir"

printf '%s' "${SUPERVISOR_TOKEN:-}" > "$CODEX_SUPERVISOR_TOKEN_FILE"
chmod 600 "$CODEX_SUPERVISOR_TOKEN_FILE"
unset SUPERVISOR_TOKEN

if [[ "$auto_update_codex" == "true" ]]; then
  update_log="/tmp/codex/codex-update.log"
  update_user_root="$CODEX_STATE_ROOT/users/anonymous"
  update_npm_cache="$update_user_root/.npm"
  update_npm_prefix="$update_user_root/.local"
  update_npm_bin="$update_npm_prefix/bin"
  mkdir -p "$update_npm_cache" "$update_npm_bin"
  chown -R 22000:0 "$update_user_root"
  chmod 700 "$update_user_root" "$update_npm_cache" "$update_npm_prefix"
  chmod 755 "$update_npm_bin"
  echo "[INFO] Updating Codex CLI with npm install -g @openai/codex@latest (timeout ${codex_update_timeout}s)"
  if timeout "$codex_update_timeout" su-exec 22000:0 env \
    "HOME=$update_user_root" \
    "NPM_CONFIG_CACHE=$update_npm_cache" \
    "NPM_CONFIG_PREFIX=$update_npm_prefix" \
    "PATH=$update_npm_bin:${PATH}" \
    npm install -g @openai/codex@latest >"$update_log" 2>&1; then
    echo "[INFO] Codex CLI update completed: $("$update_npm_bin/codex" --version 2>/dev/null || echo unknown)"
  else
    update_status=$?
    echo "[WARN] Codex CLI update failed or timed out with exit code ${update_status}; continuing with installed version"
    tail -n 10 "$update_log" 2>/dev/null | sed 's/^/[WARN] update log: /' || true
  fi
else
  echo "[INFO] Codex CLI auto-update disabled. Image version: $(codex --version 2>/dev/null || echo unknown); sessions select a healthy persistent version when it is newer."
fi

cat > "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF'
# Codex App for Home Assistant

## Path Mapping

In this App container, paths are mapped differently than HA Core:
- `/homeassistant` = HA config directory (equivalent to `/config` in HA Core)
- `/config` is this App's own configuration mount, NOT the HA Core configuration.

When users mention `/config/...`, translate to `/homeassistant/...`

Images pasted or selected in the terminal UI are saved under
`/homeassistant/tmp/codex` and their local paths are inserted into the prompt.
When the user asks about one of these images, open it with the available image
viewing tool to inspect its contents. These are local files, not remote URLs.

## Available Paths

| Path | Description | Access |
|------|-------------|--------|
| `/homeassistant` | HA configuration | read-write |
| `/share` | Shared folder | read-write |
| `/media` | Media files | read-write |
| `/ssl` | SSL certificates | read-only |
| `/backup` | Backups | read-only |

## Codex Configuration

- The App manages Codex state under `/data/codex-home/users/anonymous/.codex` in direct-ttyd ingress mode.
- The terminal uses the shared Home Assistant ingress session identity unless ttyd provides a user id.
- This global `~/.codex/AGENTS.md` file is generated by the App.
- The App merges managed defaults into `~/.codex/config.toml` without removing unrelated user settings.
- Put project instructions in `/homeassistant/AGENTS.md` (or nested `AGENTS.md` files).
- Put project-specific config in `/homeassistant/.codex/config.toml`.
- Codex only loads project-specific config from trusted projects, so trust `/homeassistant` before relying on `/homeassistant/.codex/config.toml`.

## Home Assistant Integration

The `homeassistant` MCP server connects only to Home Assistant's official Model Context Protocol Server integration at the internal `/core/api/mcp` endpoint. The App automatically authenticates through Supervisor; no URL, manual token, or separate HA login is needed. Its tools depend on the LLM APIs and entity exposure configured in HA. There is no third-party MCP fallback.

Use `ha-api status` to check official MCP, Core REST API and Supervisor API access.
Use `ha-api` for diagnostics and operations not exposed as MCP tools:

```bash
ha-api core GET /states
ha-api core GET /config
ha-api supervisor GET /core/info
ha-api supervisor GET /core/logs
ha-api check
ha-api reload automation
# Only after the user requests a restart (checks configuration first):
ha-api restart
printf '%s' '{"type":"get_states"}' | ha-api ws
printf '%s' '{"type":"config/entity_registry/list"}' | ha-api ws
printf '%s' '{"type":"subscribe_events","event_type":"state_changed"}' | ha-api ws --follow
```

POST/PUT/PATCH requests accept JSON on stdin. For example, call a service only when the user requested that action:
`printf '%s' '{"entity_id":"light.example"}' | ha-api core POST /services/light/turn_on`.
Use the scoped Supervisor API for core checks, logs and management. The bare `ha` CLI is not preauthenticated; use `ha-api` rather than looking for credentials. Supervisor enforces the App's configured API role.
The Supervisor token stays outside the interactive shell and Codex config. `ha-api` and the MCP bridge use a fixed-destination privileged helper; do not read, copy, or print credentials.

Before editing configuration, inspect the real files and entities. Preserve unrelated settings, validate with `ha-api check`, and verify the relevant entities after an authorized reload or restart. Prefer `ha-api reload <domain>` and `ha-api restart`: these shortcuts refuse to act unless a fresh configuration check succeeds. They do not add an authorization boundary to the general API. Use supported HA APIs or UI for UI-managed settings; do not edit `.storage` JSON directly. File access is limited to mapped directories and is not host/VM root access.

## Reading Home Assistant Logs

**Log levels (from most to least verbose):**
- `debug` - Only shown if explicitly enabled in configuration.yaml
- `info` - General information, shown by default
- `warning` - Warnings, always shown
- `error` - Errors, always shown

**Commands to read logs:**
```bash
# View recent logs (authenticated Supervisor API)
ha-api supervisor GET /core/logs | tail -100

# Filter by keyword
ha-api supervisor GET /core/logs | grep -i keyword

# Filter errors only
ha-api supervisor GET /core/logs | grep -iE "(error|exception)"

# Alternative: read log file directly
tail -100 /homeassistant/home-assistant.log
```

**To enable debug logging for an integration**, add to `configuration.yaml`:
```yaml
logger:
  default: info
  logs:
    custom_components.YOUR_INTEGRATION: debug
```

**Key insight:** `_LOGGER.debug()` calls are invisible unless the logger level is set to debug. Use `_LOGGER.info()` or `_LOGGER.warning()` for logs that should always appear.
EOF

validate_home="$CODEX_MANAGED_ROOT/validate-home"
rm -rf "$validate_home"
mkdir -p "$validate_home"
trap 'rm -rf "$validate_home"' EXIT
/usr/local/bin/codex-merge-config "${validate_home}/config.toml" "$default_model" "$enable_mcp" "$codex_permissions" "$codex_approval_policy"
if CODEX_HOME="$validate_home" codex debug prompt-input --help >/dev/null 2>&1; then
  CODEX_HOME="$validate_home" codex debug prompt-input "startup validation" >/dev/null
else
  echo "[WARN] Codex config parse validation unavailable in this CLI version"
fi
if [[ "$enable_mcp" == "true" ]]; then
  CODEX_HOME="$validate_home" codex mcp get homeassistant >/dev/null
  echo '[INFO] Official Home Assistant MCP registered: "homeassistant" (auto-authenticated via Supervisor)'
else
  CODEX_HOME="$validate_home" codex mcp list >/dev/null
  echo '[INFO] Home Assistant MCP disabled: "homeassistant"'
fi
rm -rf "$validate_home"
trap - EXIT

if ! timeout 20 /usr/local/bin/codex-ha-helper status; then
  echo '[WARN] HA connectivity check incomplete. The terminal remains available; run ha-api status after HA is ready.' >&2
fi

if [[ "$theme" == "dark" ]]; then
  colors='{"background":"#1e1e2e","foreground":"#cdd6f4","cursor":"#f5e0dc"}'
else
  colors='{"background":"#eff1f5","foreground":"#4c4f69","cursor":"#dc8a78"}'
fi

exec /usr/local/bin/codex-web \
  --debug 3 \
  --writable \
  --index /usr/share/codex/terminal.html \
  --ping-interval 30 \
  --max-clients 5 \
  -t "fontSize=${font_size}" \
  -t fontFamily=Monaco,Consolas,monospace \
  -t "scrollback=${terminal_scrollback}" \
  -t "disableLeaveAlert=${session_persist}" \
  -t macOptionClickForcesSelection=true \
  -t "theme=${colors}" \
  /usr/local/bin/codex-session
